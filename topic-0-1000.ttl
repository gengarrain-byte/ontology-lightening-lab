ex:Course a owl:Class ;
    rdfs:subClassOf ex:LearningResource .

ex:authoredBy a rdf:Property ;
    rdfs:domain ex:LearningResource ;
    rdfs:range ex:Person .

ex:coversTopic a rdf:Property ;
    rdfs:domain ex:LearningResource ;
    rdfs:range ex:Topic .

